{
  "name": "sql-server-test-runner",
  "version": "1.0.1",
  "description": "A simple test runner for SQL Server databases that executes .sql scripts containing sp unit tests using sqlcmd and reports failed sp executions.",
  "main": "src/index.js",
  "bin": {
    "sstr": "bin/sstr.js"
  },
  "type": "module",
  "scripts": {
    "test": "node --test --experimental-test-module-mocks \"tests/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-module-mocks --experimental-test-coverage \"tests/**/*.test.js\"",
    "test:integration": "node scripts/test-integration.mjs",
    "start": "node bin/sstr.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ironcodev/sql-server-test-runner.git"
  },
  "keywords": [
    "sqlcmd",
    "sql",
    "sql server",
    "sqlserver",
    "test-runner",
    "ssdt",
    "tdd",
    "unit test",
    "unit-test"
  ],
  "files": [
    "bin",
    "src",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "author": "IronCode",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ironcodev/sql-server-test-runner/issues"
  },
  "homepage": "https://github.com/ironcodev/sql-server-test-runner#readme",
  "engines": {
    "node": ">=22"
  }
}
